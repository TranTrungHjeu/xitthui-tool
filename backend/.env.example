# ====================================================================
# MindX Support Tools - Backend Environment Variables (Example)
# Copy this file to `.env` and fill in real values for your environment.
# Do NOT commit the real `.env` file.
# ====================================================================

# ---- Server ----
NODE_ENV=development
SERVER_PORT=4000
ALLOWED_ORIGINS=http://localhost:3000

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017/mindx_support_tools

# ---- Firebase ----
FIREBASE_API_KEY=replace_me
MINDX_FIREBASE_API_KEY=replace_me

# ---- Internal API key (used by /sessions, /spreadsheet webhooks) ----
# Migrating to OAuth2 / rotated JWTs (Q3 2026). Generate via:
#   openssl rand -hex 32
INTERNAL_API_KEY=replace_me_with_long_random_string

# ---- Token encryption (32-byte hex = 64 chars) ----
# Generate via:  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ---- LMS (MindX Learning Management System) ----
LMS_MASTER_USERNAME=
LMS_MASTER_PASSWORD=
MINDX_LMS_BASE_API=https://lms-api.mindx.edu.vn/graphql
MINDX_LMS_GATEWAY_API=https://gateway.mindx.edu.vn/graphql
MINDX_LMS_ORIGIN=https://lms.mindx.edu.vn
MINDX_LMS_REFERER=https://lms.mindx.edu.vn/

# ---- TDM centre (Thủ Dầu Một - default fallback) ----
# Override this if your deployment supports a different centre.
# All modules now read from `process.env.TDM_CENTRE_ID` via
# `backend/src/constants/centreIds.js`. If unset, the historical default
# (`6443460f94300678908f7974`) is used to preserve backward compatibility.
TDM_CENTRE_ID=6443460f94300678908f7974

# ---- Google service account (base64-encoded JSON) ----
# 1) Get the JSON file from your service account (Google Cloud Console).
# 2) Base64-encode it locally:  base64 -i serviceAccountKey.json
# 3) Paste the result below. Scripts to encode/rotate: backend/scripts/encode-service-account.js
# 4) Delete the raw serviceAccountKey.json file from the repo.
#
# NOTE (Trial report upload): as of the browser-OAuth migration, the
# /trial-report flow no longer uses the service account — it uploads
# directly to Drive from the user's browser via OAuth. This env is still
# used by Vertex AI (`controllers/class/_shared.js`,
# `services/ai/lmsTeacherComment.js`) and Google Sheets export
# (`services/googleSheets.js`), so keep it set unless you also disable
# those features.
GOOGLE_SERVICE_ACCOUNT_BASE64=

# ---- Google Drive (Trial report PDFs — legacy note) ----
# The /trial-report backend no longer talks to Drive directly because
# service-account uploads to a personal Drive folder hit
# `storageQuotaExceeded` (Google forbids service accounts from owning
# files in users' personal Drives). Uploads are now done from the user's
# browser using their own OAuth token, so the relevant env vars live
# entirely on the FRONTEND side as `NEXT_PUBLIC_GOOGLE_DRIVE_*`.
# See `frontend/.env.example`.
#
# Variables below are kept here ONLY for any external scripts that still
# read them (e.g. legacy exports). They are NOT consumed by /trial-report
# routes anymore.
GOOGLE_DRIVE_API_KEY=PLACEHOLDER
GOOGLE_DRIVE_CLIENT_ID=PLACEHOLDER
GOOGLE_DRIVE_CLIENT_SECRET=PLACEHOLDER
GOOGLE_DRIVE_ROOT_FOLDER=PLACEHOLDER_ROOT_FOLDER_ID

# ---- Redis (Item 5: distributed rate limiter) ----
# Local dev: docker run -d -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379

# ---- Slack alerting (Item 8: scheduler failure notifications) ----
# Create an Incoming Webhook at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ---- Zalo Bot (public /zalo bot integration page) ----
# Bot token issued by the Zalo OA admin console (Settings → Bot API).
# Required by /zalo/send-message. Without it, the endpoint returns 503 but
# /zalo/templates and /zalo/preview-message still respond.
ZALO_BOT_TOKEN=

# ---- Logging ----
LOG_LEVEL=info   # one of: trace, debug, info, warn, error, fatal

# ---- Payroll (Check công lương) ----
# How many months a payroll period is kept before MongoDB TTL purges it.
# Defaults to 18 months when unset. Capped at 60 in code.
PAYROLL_TTL_MONTHS=18
